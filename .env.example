# ---------------------------------------------------------------------------
# 复制为 .env 后按需填写。不填写也可以：所有用例都能用 --model offline 离线跑通。
# .env 已在 .gitignore 中，不会被提交。
# ---------------------------------------------------------------------------

# OpenAI 兼容接口（默认指向 DeepSeek 官方）
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 该接口支持的模型名为 deepseek-flash / deepseek-v4-pro
OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=sk-your-key-here

# 可选：模型输出预算。deepseek-flash 是推理模型，reasoning 亦计入 completion tokens，
# 因此这里给得比较宽裕，避免 JSON 被截断。
OPENAI_MAX_TOKENS=2500
OPENAI_TEMPERATURE=0

# 可选：Agent 护栏上限（默认值即下列数值）
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_REPEAT=2
AGENT_TIMEOUT_SEC=60
